# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# read in data
inc.sub <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2025/main/datasets/incumbents_subset.csv")
DIGITS <- 3
fmt <- function(x, k = DIGITS) formatC(x, format = "f", digits = k)
# -------- Q1: voteshare ~ difflog --------
#1. Run a regression where the outcome variable is voteshare and the explanatory variable is difflog.
m1 <- lm(voteshare ~ difflog, data = inc.sub)
inc.sub$res_q1 <- resid(m1)
cat("\n==== Q1: voteshare ~ difflog ====\n")
print(summary(m1)$coefficients)
cat("R^2 =", fmt(summary(m1)$r.squared),
"Adj.R^2 =", fmt(summary(m1)$adj.r.squared),
"n =", nobs(m1), "\n")
b1 <- coef(m1)
cat("Prediction: E[voteshare|X] = ", fmt(b1[1]), " + ", fmt(b1["difflog"]), "*difflog\n", sep = "")
cat("\nANOVA (Q1):\n"); print(anova(m1))
#2. Make a scatterplot of the two variables and add the regression line.
pdf("q1_scatter.pdf")
plot(inc.sub$difflog, inc.sub$voteshare,
main = "Incumbent Vote Share vs. Log Spending Difference",
xlab = "log(Incumbent - Challenger Spending)",
ylab = "Incumbent Vote Share",
pch = 20, col = "lightblue")
abline(m1, col = "blue", lwd = 2)
dev.off()
# -------- Q2: presvote ~ difflog --------
#1. Run a regression where the outcome variable is presvote and the explanatory variable is difflog.
m2 <- lm(presvote ~ difflog, data = inc.sub)
inc.sub$res_q2 <- resid(m2)
cat("\n==== Q2: presvote ~ difflog ====\n")
print(summary(m2)$coefficients)
cat("R^2 =", fmt(summary(m2)$r.squared),
"Adj.R^2 =", fmt(summary(m2)$adj.r.squared),
"n =", nobs(m2), "\n")
b2 <- coef(m2)
cat("Prediction: E[presvote|X] = ", fmt(b2[1]), " + ", fmt(b2["difflog"]), "*difflog\n", sep = "")
cat("\nANOVA (Q2):\n"); print(anova(m2))
#2. Make a scatterplot of the two variables and add the regression line (save as PDF).
pdf("q2_scatter.pdf")
plot(inc.sub$difflog, inc.sub$presvote,
main = "Presidential Vote Share vs. Log Spending Difference",
xlab = "log(Incumbent - Challenger Spending)",
ylab = "President's Party Vote Share",
pch = 19, col = "pink")
abline(m2, col = "red", lwd = 2)
dev.off()
# -------- Q3: voteshare ~ presvote --------
#1. Run a regression where the outcome variable is voteshare and the explanatory variable is presvote.
m3 <- lm(voteshare ~ presvote, data = inc.sub)
cat("\n==== Q3: voteshare ~ presvote ====\n")
print(summary(m3)$coefficients)
cat("R^2 =", fmt(summary(m3)$r.squared),
"Adj.R^2 =", fmt(summary(m3)$adj.r.squared),
"n =", nobs(m3), "\n")
b3 <- coef(m3)
cat("Prediction: E[voteshare|X] = ", fmt(b3[1]), " + ", fmt(b3["presvote"]), "*presvote\n", sep = "")
#2. Make a scatterplot of the two variables and add the regression line.
pdf("q3_scatter.pdf")
plot(inc.sub$presvote, inc.sub$voteshare,
main = "Incumbent Vote Share vs. Presidential Party Vote Share",
xlab = "President's Party Vote Share (presvote)",
ylab = "Incumbent Vote Share (voteshare)",
pch = 19, col = "lightgreen")
abline(m3, col = "darkgreen", lwd = 2)
dev.off()
# -------- Q4: residual regression (added-variable logic) --------
m4 <- lm(res_q1 ~ res_q2, data = inc.sub)
cat("\n==== Q4: res_q1 ~ res_q2 (added-variable) ====\n")
print(summary(m4)$coefficients)
cat("R^2 =", fmt(summary(m4)$r.squared),
"Adj.R^2 =", fmt(summary(m4)$adj.r.squared),
"n =", nobs(m4), "\n")
b4 <- coef(m4)
cat("Prediction: E[res_q1|res_q2] = ", fmt(b4[1]), " + ", fmt(b4["res_q2"]), "*res_q2\n", sep = "")
pdf("q4_addvar.pdf")
plot(inc.sub$res_q2, inc.sub$res_q1,
xlab = "Residuals from Q2: presvote ~ difflog",
ylab = "Residuals from Q1: voteshare ~ difflog",
main = "Added-variable Plot: res_q1 vs res_q2",
pch = 19, col = "yellow")
abline(m4, col = "red", lwd = 2)
dev.off()
# -------- Q5: multiple regression --------
m5 <- lm(voteshare ~ difflog + presvote, data = inc.sub)
cat("\n==== Q5: voteshare ~ difflog + presvote ====\n")
print(summary(m5)$coefficients)
cat("R^2 =", fmt(summary(m5)$r.squared),
"Adj.R^2 =", fmt(summary(m5)$adj.r.squared),
"n =", nobs(m5), "\n")
b5 <- coef(m5)
cat("Prediction: E[voteshare|X] = ", fmt(b5[1]), " + ",
fmt(b5["difflog"]), "*difflog + ",
fmt(b5["presvote"]), "*presvote\n", sep = "")
q4_vec <- coef(summary(m4))["res_q2", c("Estimate","Std. Error","t value")]
q5_vec <- coef(summary(m5))["presvote", c("Estimate","Std. Error","t value")]
cmp <- rbind(Q4_residual_reg = q4_vec, Q5_multiple_reg = q5_vec)
cat("\nFWL equivalence (presvote vs res_q2):\n"); print(cmp)
