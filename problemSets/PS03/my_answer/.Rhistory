cat("\n==== Q3: voteshare ~ presvote ====\n")
print(summary(m3)$coefficients)
cat("R^2 =", fmt(summary(m3)$r.squared),
"Adj.R^2 =", fmt(summary(m3)$adj.r.squared),
"n =", nobs(m3), "\n")
b3 <- coef(m3)
cat("Prediction: E[voteshare|X] = ", fmt(b3[1]), " + ", fmt(b3["presvote"]), "*presvote\n", sep = "")
#2. Make a scatterplot of the two variables and add the regression line.
pdf("q3_scatter.pdf")
plot(inc.sub$presvote, inc.sub$voteshare,
main = "Incumbent Vote Share vs. Presidential Party Vote Share",
xlab = "President's Party Vote Share (presvote)",
ylab = "Incumbent Vote Share (voteshare)",
pch = 19, col = "lightgreen")
abline(m3, col = "darkgreen", lwd = 2)
dev.off()
# -------- Q4: residual regression (added-variable logic) --------
#1. Run a regression where the outcome variable is the residuals from Question 1 and the explanatory variable is the residuals from Question 2.
m4 <- lm(res_q1 ~ res_q2, data = inc.sub)
cat("\n==== Q4: res_q1 ~ res_q2 (added-variable) ====\n")
print(summary(m4)$coefficients)
cat("R^2 =", fmt(summary(m4)$r.squared),
"Adj.R^2 =", fmt(summary(m4)$adj.r.squared),
"n =", nobs(m4), "\n")
b4 <- coef(m4)
cat("Prediction: E[res_q1|res_q2] = ", fmt(b4[1]), " + ", fmt(b4["res_q2"]), "*res_q2\n", sep = "")
#2. Make a scatterplot of the two residuals and add the regression line.
pdf("q4_scatter.pdf")
plot(inc.sub$res_q2, inc.sub$res_q1,
xlab = "Residuals from Q2: presvote ~ difflog",
ylab = "Residuals from Q1: voteshare ~ difflog",
main = "Added-variable Plot: res_q1 vs res_q2",
pch = 19, col = "lightsalmon")
abline(m4, col = "coral2", lwd = 2)
dev.off()
# -------- Q5: multiple regression --------
#1. Run a regression where the outcome variable is the incumbent's voteshare and the explanatory variables are difflog and presvote.
m5 <- lm(voteshare ~ difflog + presvote, data = inc.sub)
cat("\n==== Q5: voteshare ~ difflog + presvote ====\n")
print(summary(m5)$coefficients)
cat("R^2 =", fmt(summary(m5)$r.squared),
"Adj.R^2 =", fmt(summary(m5)$adj.r.squared),
"n =", nobs(m5), "\n")
b5 <- coef(m5)
cat("Prediction: E[voteshare|X] = ", fmt(b5[1]), " + ",
fmt(b5["difflog"]), "*difflog + ",
fmt(b5["presvote"]), "*presvote\n", sep = "")
q4_vec <- coef(summary(m4))["res_q2", c("Estimate","Std. Error","t value")]
q5_vec <- coef(summary(m5))["presvote", c("Estimate","Std. Error","t value")]
cmp <- rbind(Q4_residual_reg = q4_vec, Q5_multiple_reg = q5_vec)
cat("\nFWL equivalence (presvote vs res_q2):\n"); print(cmp)
