# - The coefficient on 'reserved' is the mean difference:
#     E[water | reserved=1] - E[water | reserved=0]
# - If statistically significant (|t| large, p < 0.05), we conclude reservation policy
#   is associated with a change in the number of new/repaired water facilities.
###############################################################################
# Title:        PS02 - Applied Stats I
# Description:  Q1 chi-squared by hand; Q2 bivariate regression (women.csv)
# Author:       Sein Kim
# R version:    >= 4.2
###############################################################################
rm(list = ls())
#Detach all non-base packages (kept minimal for this PS)
detachAllPackages <- function() {
basic <- c("package:stats","package:graphics","package:grDevices",
"package:utils","package:datasets","package:methods","package:base")
loaded <- search()[grepl("^package:", search())]
for (p in setdiff(loaded, basic)) detach(p, character.only = TRUE)
}
# detachAllPackages()
# -------------------------------#
# Q1. Political Science (Chi-squared)
# -------------------------------#
# Observed counts (rows: class, cols: outcome)
#            NotStopped  BribeRequested  StoppedWarning
# Upper            14            6               7
# Lower             7            7               1
obs <- matrix(c(14, 6, 7,
7,  7, 1),
nrow = 2, byrow = TRUE)
dimnames(obs) <- list(Class = c("Upper","Lower"),
Outcome = c("NotStopped","BribeReq","StoppedWarn"))
# (a) Chi-squared test statistic by hand (no Yates correction)
total <- sum(obs)
row_tot <- rowSums(obs)
col_tot <- colSums(obs)
expct   <- outer(row_tot, col_tot) / total  # expected counts
chi2_manual <- sum((obs - expct)^2 / expct)
df_q1 <- (nrow(obs) - 1) * (ncol(obs) - 1)
cat("Q1(a) Chi-squared (manual) =", round(chi2_manual, 4),
" with df =", df_q1, "\n")
# (b) p-value from manual chi2
pval_manual <- pchisq(chi2_manual, df = df_q1, lower.tail = FALSE)
cat("Q1(b) p-value (manual) =", round(pval_manual, 4), "\n")
# Also verify with chisq.test()
chi_fit <- chisq.test(obs, correct = FALSE)
cat("Q1 verify: chisq.test X^2 =", round(chi_fit$statistic, 4),
" df =", chi_fit$parameter,
" p-value =", round(chi_fit$p.value, 4), "\n")
# (c) Standardized residuals (R returns 'stdres')
stdres <- chi_fit$stdres
cat("Q1(c) Standardized residuals (rounded):\n")
print(round(stdres, 3))
# -------------------------------#
# Q2. Economics (women.csv)
# -------------------------------#
# Data source (from problem statement)
women_url <- "https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv"
dat <- read.csv(women_url)
# Inspect basic structure (helpful for the write-up)
cat("\nQ2 data preview (names, head):\n")
print(names(dat))
print(head(dat, 3))
# We expect columns: 'reserved' (policy indicator) and 'water' (new/repaired drinking water facilities)
# If names differ, adjust the two lines below:
outcome_var <- "water"
treat_var   <- "reserved"
# Quick sanity checks
if (!(outcome_var %in% names(dat))) {
stop("Column 'water' not found. Check column names and set 'outcome_var' accordingly.")
}
if (!(treat_var %in% names(dat))) {
stop("Column 'reserved' not found. Check column names and set 'treat_var' accordingly.")
}
# (a) Hypotheses (two-sided):
# H0: mean(water | reserved=1) = mean(water | reserved=0)
# H1: mean(water | reserved=1) != mean(water | reserved=0)
# (b) Bivariate regression: water ~ reserved
form_q2 <- as.formula(paste0(outcome_var, " ~ ", treat_var))
mod_q2  <- lm(form_q2, data = dat)
cat("\nQ2(b) OLS summary:\n")
print(summary(mod_q2))
# Group means for intuition
grp_means <- tapply(dat[[outcome_var]], dat[[treat_var]], mean, na.rm = TRUE)
cat("\nQ2 group means (water by reserved):\n")
print(grp_means)
# (c) Interpretation guide (to use in LaTeX write-up):
# - The coefficient on 'reserved' is the mean difference:
#     E[water | reserved=1] - E[water | reserved=0]
# - If statistically significant (|t| large, p < 0.05), we conclude reservation policy
#   is associated with a change in the number of new/repaired water facilities.
R.version
# 2) Helper: install/load packages (keep it simple; base R is enough here)
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[, "Package"])]
if (length(new.pkg)) install.packages(new.pkg, dependencies = TRUE)
sapply(pkg, require, character.only = TRUE)
}
# (No extra pkgs required, base R only)
lapply(c(), pkgTest)
# Build observed contingency table
obs <- rbind(
Upper = c(`Not Stopped` = 14, `Bribe requested` = 6, `Stopped/given warning` = 7),
Lower = c(`Not Stopped` = 7,  `Bribe requested` = 7, `Stopped/given warning` = 1)
)
# (a) Compute chi-square statistic by hand (manual)
row_tot <- rowSums(obs)
col_tot <- colSums(obs)
N       <- sum(obs)
expct   <- outer(row_tot, col_tot) / N                 # expected counts under independence
chi_man <- sum((obs - expct)^2 / expct)                # Pearson chi-square
# Show manual results
cat("Q1 (a) Manual chi-square =", round(chi_man, 4), "\n")
cat("Degrees of freedom =", (nrow(obs)-1)*(ncol(obs)-1), "\n\n")
# (b) p-value from the manual test statistic
df_q1  <- (nrow(obs)-1)*(ncol(obs)-1)
p_man  <- 1 - pchisq(chi_man, df = df_q1)
cat("Q1 (b) p-value (manual) =", round(p_man, 4), "\n\n")
# Also check with chisq.test (no Yates correction for 2x2 since this is 2x3)
ct <- suppressWarnings(chisq.test(obs, correct = FALSE))
cat("Q1 check: chisq.test$stat =", round(ct$statistic, 4),
" df =", ct$parameter, " p-value =", round(ct$p.value, 4), "\n\n")
# (c) Standardized residuals (adjusted standardized residuals)
# Use chisq.test's stdres (commonly reported)
std_res <- ct$stdres
cat("Q1 (c) Standardized residuals:\n")
print(round(std_res, 3))
cat("\n")
# (Optional) Pearson residuals if needed: (O - E)/sqrt(E)
pearson_res <- (obs - expct) / sqrt(expct)
# Load data
url_women <- "https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv"
dat <- read.csv(url_women)
# (b) Bivariate regression
fit <- lm(water ~ reserved, data = dat)
smry <- summary(fit)
cat("Q2 (b) Regression summary (water ~ reserved):\n")
print(smry)
cat("\n")
# Extract coefficient for 'reserved'
b1  <- coef(fit)["reserved"]
se1 <- smry$coefficients["reserved", "Std. Error"]
t1  <- smry$coefficients["reserved", "t value"]
p1  <- smry$coefficients["reserved", "Pr(>|t|)"]
cat("coef(reserved) =", round(b1, 3),
"SE =", round(se1, 3),
"t =", round(t1, 3),
"p =", round(p1, 4), "\n\n")
# ---- Optional Visualization to strengthen Q2 (saves a PDF) ----
# Boxplot comparing water by reserved; red dots for group means
pdf("q2_water_by_reserved.pdf", width = 6, height = 5)
boxplot(water ~ reserved, data = dat,
main = "Water Facilities by Reservation Status",
xlab = "Reserved for Women (0 = No, 1 = Yes)",
ylab = "Number of New/Repaired Water Facilities",
col  = c("lightgray", "lightblue"))
grp_means <- tapply(dat$water, dat$reserved, mean, na.rm = TRUE)
points(1:2, grp_means, pch = 19, col = "red")
dev.off()
cat("Saved figure: q2_water_by_reserved.pdf\n")
