# Load data
df <- readRDS("datasets/movies.rds")
View(df)
# Dataframe subsetting: df[rows, columns]
df_s <- df[df$genre=="Comedy" |
df$genre=="Drama" |
df$genre=="Documentary", ]
df_s$genre <- droplevels(df_s$genre)
View(df_s)
# Run Chi squared test
chisq.test(df_s$genre,
df_s$critics_rating)
